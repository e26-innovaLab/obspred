# ==============================================================================
# Configuración del Entorno - Observatorio Predictivo Backend
# ==============================================================================

# Entorno de ejecución: development | testing | production
APP_ENV=development
APP_NAME="Observatorio Predictivo API"
APP_DESCRIPTION="API backend de analítica socioeconómica, laboral y educativa"
API_V1_PREFIX=/api/v1
DEBUG=True

# Configuración del Servidor HTTP
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Seguridad y CORS (JSON array de cadenas de orígenes permitidos)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Conexión a Base de Datos Relacional
# ------------------------------------------------------------------------------
# 1. PostgreSQL en Docker (docker-compose.yml):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/obspred_db

# 2. Alternativa ligera SQLite para desarrollo local sin Docker:
# DATABASE_URL=sqlite+aiosqlite:///./obspred_dev.db

# Registro de sentencias SQL generadas por el ORM en consola (True para depuración)
DATABASE_ECHO=False

# ------------------------------------------------------------------------------
# Almacenamiento Local de Archivos (Módulo de Ingesta)
# ------------------------------------------------------------------------------
# Directorio físico donde se almacenan los datasets CSV subidos
UPLOAD_DIR=data/uploads

# Tamaño máximo permitido para subida de archivos en bytes (52428800 bytes = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
