# ==============================================================================
# Configuración del Entorno - Observatorio Predictivo Backend
# ==============================================================================

# Entorno de ejecución: development | testing | production
APP_ENV=development
APP_NAME="Observatorio Predictivo API"
APP_DESCRIPTION="API backend de analítica socioeconómica, laboral y educativa"
API_V1_PREFIX=/api/v1
DEBUG=True

# Configuración del Servidor HTTP
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Seguridad y CORS (JSON array de cadenas)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Conexión a Base de Datos Relacional (PostgreSQL / Supabase vía asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/obspred_db
# Alternativa ligera para desarrollo local sin Docker:
# DATABASE_URL=sqlite+aiosqlite:///./obspred_dev.db
DATABASE_ECHO=False
